# Frontend on Vercel (local defaults work without a .env file)
PUBLIC_APP_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:4000

# Backend on Railway. Keep all values below private, never NEXT_PUBLIC_.
# Production: PUBLIC_APP_URL must be the exact HTTPS frontend origin.
# Railway: mount a volume at /data and set DATA_DIR=/data.
# Local data is saved in ./data automatically.
DATA_DIR=./data
# BETTER_AUTH_SECRET=generate-a-unique-random-secret-at-deployment

# Production email verification and password resets (required before publishing)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Optional AI: no requests are made without an API key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_USER_DAILY_LIMIT=10
AI_TOTAL_DAILY_LIMIT=100
UPLOAD_TOTAL_MB=1024
