# Frontend on Vercel
PUBLIC_APP_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:4000

# Production PostgreSQL on Railway. Inject this from the PostgreSQL service.
# DATABASE_URL=
DATABASE_POOL_SIZE=10

# Local development only. Production data does not use this folder.
DATA_DIR=./data

# Private authentication secret. Generate once, store in a password manager,
# and keep the same value during restores and redeployments.
# BETTER_AUTH_SECRET=
# BACKEND_PROXY_SECRET=generate-a-different-strong-random-secret

# Production email verification and password resets
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Railway private object-storage bucket. Inject these from the bucket service.
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_DEFAULT_REGION=auto
# AWS_S3_URL_STYLE=virtual

# Optional AI. Keep the key only in Railway.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_USER_DAILY_LIMIT=10
AI_TOTAL_DAILY_LIMIT=100

# 10 GB platform total and 1 GB per contributor are enforced by the API.
UPLOAD_TOTAL_MB=10240
